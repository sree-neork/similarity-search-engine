# Qdrant connection
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=keywords

# Embedding model (any fastembed-supported model)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# SQLite metadata store
DATABASE_URL=sqlite:////data/simsearch.db

# Search defaults
DEFAULT_TOP_K=10
# Namespaces with <= this many keywords are scored exhaustively (exact total).
# Larger namespaces use a bounded cosine candidate pool (approximate total).
EXACT_SCAN_LIMIT=2000
CANDIDATE_MULTIPLIER=5
MIN_CANDIDATES=50

# Hybrid score weights (need not sum to 1; results are comparable relatively)
W_SEMANTIC=0.5
W_FUZZY=0.4
W_ACRONYM=0.1
